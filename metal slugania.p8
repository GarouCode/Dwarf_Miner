pico-8 cartridge // http://www.pico-8.com
version 41
__lua__
function _init()

plr_soldier = {
	sp=18,
	animsp=22,
	x=10,
	y=10,
	m_x=1,
	m_y=1,
	d=4,
	acc=1
	}
	
walkstate = false

end

function _update()
	plr_soldier.d -= 1
	if btn(1) then
	walkstate = true
	plr_soldier.x += plr_soldier.m_x
 else
 walkstate = false
 end
 
 if walkstate == true then
 	plr_soldier.d -= 1
 	if plr_soldier.d < 0 then
 	plr_soldier.animsp += 2
 	plr_soldier.d = 4
 	if plr_soldier.animsp > 28 then
 		plr_soldier.animsp = 22
 	end
 	end 
 end
 
end

function _draw()
cls()
if walkstate == false then
	spr(plr_soldier.sp,plr_soldier.x,plr_soldier.y,2,2)
	spr(1,plr_soldier.x+9,plr_soldier.y+4)
else
	spr(plr_soldier.animsp,plr_soldier.x,plr_soldier.y,2,2)
 spr(1,plr_soldier.x+9,plr_soldier.y+4)
end
end
