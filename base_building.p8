pico-8 cartridge // http://www.pico-8.com
version 41
__lua__
function _init()
 t=0
 
	build_a = {
	x1=8,
	x2=18,
	y1=104,
	y2=84,
	col=8,
	upgrade_lvl=1,
	upgrade_cost=10
	}
	
	upgrade_req = 2
	
	credits = 0
	resources = 0
	
	time_resource = 5
	time_increment = 0.10
	
	jeep = {
	x=100
	}
	
end

function _update()
	
	t+=time_increment
	jeep.x = jeep.x-t/20
	
	if jeep.x < -10 then
		jeep.x = 128
	end
	
	if t >= time_resource then
 	resources += 100
 	time_resource *= 2
 end
 
 if build_a.lvl == upgrade_req then
 	time_increment += 1
 	upgrade_req += 2
 end
	
 if btnp(❎) then
 	credits += 1
 end
 if btnp(🅾️) then
 	upgrade_building(build_a)
 end
 
end

function _draw()
	cls()
	print("credits: "..credits, 0, 0, 7)
	print("resources: "..resources, 0, 8, 7)
	print(t, 0, 17, 7)
	print(time_resource, 0, 27, 7)
	rect(build_a.x1, build_a.y1, build_a.x2, build_a.y2, build_a.col)

	spr(1, jeep.x, 102)
end

-->8
function upgrade_building(building)
	if credits >= building.upgrade_cost then
		building.upgrade_lvl += 1
		building.upgrade_cost += 10
		credits -= 10
		building.y2 -= 3
	end	
end
